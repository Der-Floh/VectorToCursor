<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Third-party trim/AOT warnings are reviewed, not allowed to abort the publish. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VectorToCursor.Tests" />
  </ItemGroup>

</Project>
